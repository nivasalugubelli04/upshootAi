# ============================================
# Upshoot AI - Environment Template Example
# Duplicate to .env or .env.local and fill in your keys
# ============================================

# MSG91 SMS & OTP Configuration (Backend only - NEVER prefix with NEXT_PUBLIC_)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Resend Email Configuration
RESEND_API_KEY=
CONTACT_EMAIL=Upshootai@gmail.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
